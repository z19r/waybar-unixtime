# Maintainer: Zack Kitzmiller <zackkitzmiller@gmail.com>
pkgname=waybar-unixtime
pkgver=0.3.0
pkgrel=1
pkgdesc="Live unix timestamps for Waybar, themed by your omarchy theme"
arch=('x86_64' 'aarch64')
url="https://github.com/z19r/waybar-unixtime"
license=('MIT')
depends=('gcc-libs')
makedepends=('cargo')
optdepends=(
  'waybar: the bar this module renders into'
  'wl-clipboard: click-to-copy timestamps'
  'omarchy: theme inheritance'
)
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
  cd "$pkgname-$pkgver"
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$pkgname-$pkgver"
  cargo test --frozen --release
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 "target/release/$pkgname" "$pkgdir/usr/bin/$pkgname"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
